rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner() {
      return signedIn()
        && request.auth.token.email == 'editpeakstudio@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }
    function hasUser() { return signedIn() && exists(userPath(request.auth.uid)); }
    function profile() { return get(userPath(request.auth.uid)).data; }
    function activeAdmin() {
      return owner() || (hasUser()
        && profile().role in ['admin', 'master_admin']
        && profile().isSuspended != true);
    }
    function masterAdmin() {
      return owner() || (hasUser() && profile().role == 'master_admin'
        && profile().isSuspended != true);
    }
    function permitted(key) {
      return masterAdmin() || (activeAdmin()
        && profile().permissions is list
        && profile().permissions.hasAny([key]));
    }
    function canManageUsers() { return permitted('students.manage'); }
    function canManageAdmins() { return owner() || permitted('admins.manage'); }
    function canVerifyPayments() { return permitted('payments.verify'); }
    function canManageSettings() { return permitted('settings.manage'); }
    function canManageTelegram() { return owner() || masterAdmin() || permitted('telegram.manage') || permitted('settings.manage'); }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function validCategory(id) {
      return request.resource.data.id == id
        && request.resource.data.name is string
        && request.resource.data.slug is string
        && request.resource.data.thumbnailUrl is string
        && request.resource.data.price is number
        && request.resource.data.isActive is bool
        && request.resource.data.createdAt is string;
    }
    function validFolder(id) {
      return request.resource.data.id == id
        && request.resource.data.name is string
        && (request.resource.data.parentId == null || request.resource.data.parentId is string)
        && request.resource.data.order is number
        && request.resource.data.createdAt is string;
    }
    function validVideo(id) {
      return request.resource.data.id == id
        && request.resource.data.title is string
        && request.resource.data.categoryId is string
        && request.resource.data.videoUrl is string
        && request.resource.data.isPublished is bool
        && request.resource.data.isFreePreview is bool
        && request.resource.data.order is number
        && request.resource.data.createdAt is string;
    }
    function validPdf(id) {
      return request.resource.data.id == id
        && request.resource.data.title is string
        && request.resource.data.categoryId is string
        && request.resource.data.pdfUrl is string
        && request.resource.data.isPublished is bool
        && request.resource.data.order is number
        && request.resource.data.pageCount is number
        && request.resource.data.createdAt is string;
    }
    // Descriptive listing of a lesson. Deliberately has no `videoUrl` field:
    // the playable link stays in `videos`, which requires an entitlement.
    function validCatalogEntry(id) {
      return request.resource.data.id == id
        && request.resource.data.title is string
        && request.resource.data.categoryId is string
        && request.resource.data.order is number
        && request.resource.data.isPublished is bool
        && request.resource.data.isFreePreview is bool
        && request.resource.data.createdAt is string
        && request.resource.data.keys().hasOnly([
          'id','title','description','categoryId','categoryName','folderId','folderName',
          'episode','duration','thumbnailUrl','isPublished','isFreePreview','order',
          'createdAt','updatedAt'
        ]);
    }
    function userHasActiveWindow(u) {
      return u.isSuspended != true
        && u.get('accountStatus', 'active') != 'suspended'
        && u.get('subscriptionStatus', 'none') != 'expired'
        && (!('accessExpiryAt' in u) || u.accessExpiryAt == null || u.accessExpiryAt > request.time);
    }
    function ownsEntitlement(categoryId) {
      return signedIn() && exists(userPath(request.auth.uid))
        && userHasActiveWindow(get(userPath(request.auth.uid)).data)
        && (get(userPath(request.auth.uid)).data.hasAllAccess == true
          || (get(userPath(request.auth.uid)).data.allowedCategories is list
            && get(userPath(request.auth.uid)).data.allowedCategories.hasAny([categoryId]))
          || ('assignedCourses' in get(userPath(request.auth.uid)).data
            && get(userPath(request.auth.uid)).data.assignedCourses is list
            && get(userPath(request.auth.uid)).data.assignedCourses.hasAny([categoryId])));
    }
    function canReadVideo() {
      return activeAdmin() || (signedIn() && resource.data.isPublished == true
        && (resource.data.isFreePreview == true || ownsEntitlement(resource.data.categoryId)));
    }
    function canReadPdf() {
      return activeAdmin() || (signedIn() && resource.data.isPublished == true
        && ownsEntitlement(resource.data.categoryId));
    }

    match /users/{uid} {
      allow get: if self(uid) || activeAdmin();
      allow list: if activeAdmin();
      allow create: if (owner() && uid == request.auth.uid)
        || (self(uid)
          && request.resource.data.role == 'user'
          && request.resource.data.permissions == []
          && request.resource.data.isPlatformOwner == false
          && request.resource.data.hasAllAccess == false
          && request.resource.data.isSuspended == false
          && (!('accountStatus' in request.resource.data) || request.resource.data.accountStatus == 'active')
          && request.resource.data.subscriptionStatus == 'none'
          && request.resource.data.allowedCategories is list
          && request.resource.data.allowedCategories.size() == 0
          && (!('assignedCourses' in request.resource.data)
            || (request.resource.data.assignedCourses is list && request.resource.data.assignedCourses.size() == 0))
          && (!('uid' in request.resource.data) || request.resource.data.uid == uid)
          && (!('accessExpiry' in request.resource.data) || request.resource.data.accessExpiry == null)
          && (!('accessExpiryAt' in request.resource.data) || request.resource.data.accessExpiryAt == null)
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 160
          && request.resource.data.email is string
          && request.resource.data.email.size() <= 320
          && (('email' in request.auth.token && request.auth.token.email != null)
            ? request.resource.data.email.lower() == request.auth.token.email.lower()
            : request.resource.data.email == '')
          && request.resource.data.keys().hasOnly([
            'uid','email','displayName','photoURL','phoneNumber','authProvider','role','isPlatformOwner',
            'predefinedRole','assignedRoleTitle','permissions','isSuspended','accountStatus','hasAllAccess',
            'allowedCategories','allowedFolders','assignedCourses','subscriptionStatus','accessExpiry',
            'accessExpiryAt','lastLogin','lastLoginAt','createdAt'
          ]));
      allow update: if (owner() && uid != request.auth.uid
          && resource.data.role != 'master_admin'
          && resource.data.isPlatformOwner != true)
        || (canManageAdmins() && uid != request.auth.uid
          && resource.data.isPlatformOwner != true
          && resource.data.role != 'master_admin'
          && request.resource.data.role in ['user','admin']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'role','predefinedRole','assignedRoleTitle','permissions','isSuspended','accountStatus'
          ])
          && request.resource.data.permissions is list
          && (masterAdmin() || request.resource.data.permissions.hasOnly(profile().permissions))
          && request.resource.data.permissions.hasOnly([
            'dashboard.view','analytics.view','folders.create','folders.edit','folders.delete',
            'videos.create','videos.edit','videos.delete','pdfs.create','pdfs.edit','pdfs.delete',
            'students.manage','payments.verify','settings.manage','admins.manage','audit.view',
            'telegram.manage'
          ]))
        || (owner() && uid != request.auth.uid && resource.data.role == 'master_admin'
          && resource.data.isPlatformOwner != true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'role','predefinedRole','assignedRoleTitle','permissions','isSuspended','accountStatus','hasAllAccess','subscriptionStatus'
          ]))
        || ((canManageUsers() || canVerifyPayments()) && uid != request.auth.uid
          && resource.data.isPlatformOwner != true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'hasAllAccess','allowedCategories','assignedCourses','subscriptionStatus','accessExpiry','accessExpiryAt'
          ])
          && request.resource.data.hasAllAccess is bool
          && request.resource.data.allowedCategories is list
          && request.resource.data.allowedCategories.size() <= 200
          && (!('assignedCourses' in request.resource.data)
            || (request.resource.data.assignedCourses is list && request.resource.data.assignedCourses.size() <= 200))
          && request.resource.data.subscriptionStatus in ['active','cancelled','expired','none']
          && (!('accessExpiry' in request.resource.data)
            || request.resource.data.accessExpiry == null
            || (request.resource.data.accessExpiry is string && request.resource.data.accessExpiry.size() <= 64))
          && (!('accessExpiryAt' in request.resource.data)
            || request.resource.data.accessExpiryAt == null
            || request.resource.data.accessExpiryAt is timestamp))
        || ((canManageUsers() || owner()) && uid != request.auth.uid
          && resource.data.isPlatformOwner != true
          && (owner() || resource.data.role != 'master_admin')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'isSuspended','accountStatus'
          ])
          && request.resource.data.isSuspended is bool
          && (!('accountStatus' in request.resource.data)
            || request.resource.data.accountStatus in ['active','suspended']))
        || (self(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid','displayName','photoURL','phoneNumber','authProvider','lastLogin','lastLoginAt'
        ])
          && request.resource.data.email == resource.data.email
          && request.resource.data.role == resource.data.role
          && (!('uid' in request.resource.data) || request.resource.data.uid == uid))
        || (owner() && self(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid','displayName','photoURL','phoneNumber','authProvider','lastLogin','lastLoginAt',
          'isPlatformOwner','role','hasAllAccess','subscriptionStatus','accountStatus','isSuspended',
          'permissions','predefinedRole','assignedRoleTitle'
        ]));
      allow delete: if owner() && uid != request.auth.uid && resource.data.isPlatformOwner != true;
    }

    match /categories/{id} {
      allow read: if signedIn() || resource.data.isActive == true;
      allow create: if permitted('folders.create') && validCategory(id);
      allow update: if permitted('folders.edit') && validCategory(id);
      allow delete: if permitted('folders.delete');
    }
    match /folders/{id} {
      allow read: if signedIn();
      allow create: if permitted('folders.create') && validFolder(id);
      allow update: if permitted('folders.edit') && validFolder(id);
      allow delete: if permitted('folders.delete');
    }
    match /videos/{id} {
      allow read: if canReadVideo();
      allow create: if permitted('videos.create') && validVideo(id);
      allow update: if permitted('videos.edit') && validVideo(id);
      allow delete: if permitted('videos.delete');
    }
    match /videoCatalog/{id} {
      allow get, list: if resource.data.isPublished == true;
      allow create, update: if (permitted('videos.create') || permitted('videos.edit'))
        && validCatalogEntry(id);
      allow delete: if permitted('videos.delete');
    }
    match /pdfs/{id} {
      allow read: if canReadPdf();
      allow create: if permitted('pdfs.create') && validPdf(id);
      allow update: if permitted('pdfs.edit') && validPdf(id);
      allow delete: if permitted('pdfs.delete');
    }

    match /paymentRequests/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.id == id
        && request.resource.data.status == 'pending'
        && request.resource.data.planType in ['all_access','category']
        && (request.resource.data.planType != 'category' || request.resource.data.categoryId is string)
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.utr is string && request.resource.data.utr.size() > 0 && request.resource.data.utr.size() <= 128
        && request.resource.data.proofUrl is string
        && request.resource.data.proofUrl.size() <= 900000
        && (('email' in request.auth.token && request.auth.token.email != null)
          ? request.resource.data.userEmail.lower() == request.auth.token.email.lower()
          : request.resource.data.userEmail == '')
        && request.resource.data.keys().hasOnly([
          'id','uid','userEmail','userName','planType','categoryId','categoryName',
          'amount','utr','proofUrl','status','submittedAt'
        ]);
      allow get, list: if signedIn() && (resource.data.uid == request.auth.uid || canVerifyPayments());
      allow update: if canVerifyPayments() && resource.data.status == 'pending'
        && request.resource.data.status in ['approved','rejected']
        && (('email' in request.auth.token && request.auth.token.email != null)
          ? request.resource.data.resolvedBy.lower() == request.auth.token.email.lower()
          : request.resource.data.resolvedBy == '')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','adminNote','resolvedAt','resolvedBy'
        ]);
      allow delete: if owner();
    }
    match /payment_requests/{id} { allow read, write: if false; }
    match /settings/{id} {
      allow read: if signedIn();
      allow create, update: if canManageSettings() || (id == 'telegram' && canManageTelegram());
      allow delete: if owner();
    }
    match /sales_analytics/{id} {
      allow read: if permitted('analytics.view');
      allow create: if canVerifyPayments();
      allow update, delete: if owner();
    }
    match /audit_logs/{id} {
      allow read: if permitted('audit.view');
      allow create: if activeAdmin()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.timestamp is string;
      allow update, delete: if false;
    }
    // Telegram Multi-Bot Payment Notification Collections
    // Tokens are NEVER stored in plaintext: only AES-256-GCM encryptedToken and maskedToken.
    match /telegramBots/{id} {
      allow read: if canManageTelegram();
      allow create, update: if canManageTelegram()
        && request.resource.data.id == id
        && request.resource.data.botName is string
        && request.resource.data.chatId is string
        && request.resource.data.encryptedToken is string
        && request.resource.data.maskedToken is string
        && request.resource.data.isActive is bool
        && !request.resource.data.keys().hasAny(['token', 'botToken', 'plainToken', 'rawToken']);
      allow delete: if canManageTelegram();
    }
    match /telegramNotificationJobs/{id} {
      allow read: if canManageTelegram() || canVerifyPayments();
      allow create, update: if canManageTelegram() || canVerifyPayments();
      allow delete: if owner();
    }
    match /telegramNotificationLogs/{id} {
      allow read: if canManageTelegram() || canVerifyPayments();
      allow create, update: if canManageTelegram() || canVerifyPayments();
      allow delete: if owner();
    }
    // Skill-Flix AI Configuration & Encrypted API Key Vault (Owner / Super Admin ONLY)
    // Plaintext API keys are rejected; only AES-256-GCM encryptedGeminiApiKey + maskedGeminiApiKey allowed.
    match /aiConfig/{id} {
      allow read: if masterAdmin();
      allow create, update: if masterAdmin()
        && request.resource.data.id == id
        && request.resource.data.aiProvider in ['gemini', 'openrouter', 'groq']
        && request.resource.data.geminiAiModel is string
        && request.resource.data.geminiFallbackModel is string
        && request.resource.data.rateLimitPerMin is number
        && request.resource.data.rateLimitPerDay is number
        && !request.resource.data.keys().hasAny([
          'geminiApiKey', 'GEMINI_API_KEY', 'apiKey', 'plainKey', 'rawKey', 'secret', 'openrouterApiKey', 'groqApiKey'
        ]);
      allow delete: if owner();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
